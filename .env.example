# ──────────────────────────────────────────────
# Embeddings
# ──────────────────────────────────────────────
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BATCH_SIZE=32
EMBEDDING_BATCH_PAUSE_SECONDS=2

# ──────────────────────────────────────────────
# LLM / provider keys  (Gemini only)
# ──────────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here

# ──────────────────────────────────────────────
# Chroma Cloud
# ──────────────────────────────────────────────
CHROMA_API_KEY=your-chroma-cloud-api-key-here
CHROMA_TENANT=your-chroma-tenant-here
CHROMA_DATABASE=your-chroma-database-here
CHROMA_COLLECTION=financial_docs

# ──────────────────────────────────────────────
# Relational database (hosted Postgres)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require

# ──────────────────────────────────────────────
# Cloud object storage  (remote | local)
# local writes to a temp folder; used only for tests
# ──────────────────────────────────────────────
STORAGE_BACKEND=remote
STORAGE_ENDPOINT_URL=https://s3.amazonaws.com
STORAGE_BUCKET=your-bucket-name-here
STORAGE_ACCESS_KEY_ID=your-access-key-id-here
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key-here
STORAGE_REGION=us-east-1

# ──────────────────────────────────────────────
# API / CORS
# ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
